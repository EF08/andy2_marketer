#!/bin/sh
# Blocks the private business layer from ever entering a commit,
# even via `git add -f`. Bypass (only if you truly mean it): --no-verify
BLOCK='^(MASTERPLAN\.md|skills-lock\.json|docs/(BRIEF|INFLUENCERS|STATUS)\.md|\.claude/|\.agents/|private/|.*\.private\.(md|json)|\.env|data/|profiles/|.*\.(xlsx|csv))$'

staged=$(git diff --cached --name-only --diff-filter=ACMR)
bad=$(printf '%s\n' "$staged" | grep -E "$BLOCK")

if [ -n "$bad" ]; then
  echo "BLOCKED: private files are staged for a PUBLIC repo:" >&2
  printf '  %s\n' $bad >&2
  echo "" >&2
  echo "Unstage with:  git restore --staged $(printf '%s ' $bad)" >&2
  exit 1
fi

# Secret-shaped strings in staged content
if git diff --cached -U0 | grep -qE '(sk-[A-Za-z0-9_-]{20,}|AIza[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{20,}|mongodb\+srv://|xox[baprs]-|BEGIN [A-Z ]*PRIVATE KEY)'; then
  echo "BLOCKED: a secret-shaped string appears in the staged diff." >&2
  exit 1
fi
exit 0
